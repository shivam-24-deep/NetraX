# Frontend (safe to expose in the browser bundle — Supabase anon key is public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local dev convenience ONLY — set to "true" to skip the Supabase login wall and land
# straight on the dashboard. Leave unset/false anywhere but your own machine.
VITE_SKIP_AUTH=false

# Server-side only (Supabase Edge Functions) — never prefix with VITE_ or it will be bundled into client code
GEMINI_API_KEY=
