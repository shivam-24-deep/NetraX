# Frontend (safe to expose in the browser bundle — Supabase anon key is public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local dev convenience ONLY — set to "true" to skip the Supabase login wall and land
# straight on the dashboard. Leave unset/false anywhere but your own machine.
VITE_SKIP_AUTH=false

# Local ML inference API (ml/api/server.py — run: uvicorn api.server:app --port 8000
# from ml/ with the venv active). Optional: if unreachable, the app automatically
# falls back to rule-based-only evidence, so this can be left as-is.
VITE_ML_API_URL=http://localhost:8000

# Server-side only (Supabase Edge Functions) — never prefix with VITE_ or it will be bundled into client code
GEMINI_API_KEY=

# --- Gmail auto-detect (server/gmail-client.ts, server/local-api.ts) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application), with this exact redirect URI registered:
#   http://localhost:8787/auth/google/callback
# Also enable the "Gmail API" under APIs & Services -> Library, and add your
# own test Gmail address under OAuth consent screen -> Test users (Testing
# mode needs no verification). See docs/mobile-ingestion.md for full steps.
# Without these, "Connect Gmail" reports "not configured", never a fake
# connected state.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# --- Dataset acquisition & threat intelligence (server-side / scripts only) ---
# PhishTank (https://phishtank.org/) — register a free account, then generate an
# app_key. Without it, bulk downloads are rate-limited/blocked (HTTP 429) and the
# live checkurl lookup is heavily throttled. Missing key = adapter reports
# "Threat intelligence unavailable", never a fake result.
PHISHTANK_APP_KEY=

# URLhaus (https://urlhaus.abuse.ch/) — static bulk CSV/JSON downloads work without
# a key, but the live query API (single-URL/host lookups, which the app actually
# uses) now requires one — verified 2026-09-06. Get one free at https://auth.abuse.ch/.
# Without it, the app reports "Threat intelligence unavailable" rather than guessing.
URLHAUS_AUTH_KEY=

# MaxMind GeoLite2 (https://www.maxmind.com/en/geolite2/signup) — free account
# required for both values. Without them, geolocation/ASN enrichment is skipped
# and the UI reports "Geolocation unavailable" rather than guessing.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- Deployed API (server/local-api.ts on Render; see render.yaml) ---
# REQUIRE_AUTH=true makes every route except /health need a valid Supabase login,
# limits CORS to ALLOWED_ORIGINS, rate-limits per user, and disables the Gmail routes.
REQUIRE_AUTH=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated frontend origins; https://*.vercel.app style wildcards are allowed.
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MIN=60
# Hosted ML service (second Render service): its URL, a shared key, and a timeout long
# enough for a sleeping free-tier Space (local default is 2500 ms).
ML_API_URL=
ML_API_KEY=
ML_TIMEOUT_MS=
